[Unit]
Description=Bramble metered relay (rendezvous + data relay), instance %i
After=network-online.target
Wants=network-online.target

[Service]
User=bramble
EnvironmentFile=/etc/bramble/relay-%i.env
WorkingDirectory=/opt/bramble/relay
ExecStart=/opt/bramble/relay/bin/relay \
  -addr ${RELAY_ADDR} \
  -meter -data-relay \
  -payee ${RELAY_PAYEE_ACCOUNT_ID} \
  -sidecar-dir /opt/bramble/relay-sidecar \
  -sidecar-port ${RELAY_SIDECAR_PORT} \
  -internal-port ${RELAY_INTERNAL_PORT} \
  -price-per-byte ${RELAY_PRICE_PER_BYTE} \
  -data-host ${RELAY_DATA_HOST}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
