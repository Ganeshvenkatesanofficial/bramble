[Unit]
Description=Bramble approval console (admin loopback :3011)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/bramble-work/approval-runtime/approval
Environment=HOME=%h
Environment=NODE_ENV=production
EnvironmentFile=%h/.config/bramble/approval.env
ExecStart=/usr/bin/env node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3011
Restart=always
RestartSec=3
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
