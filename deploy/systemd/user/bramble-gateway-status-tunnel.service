[Unit]
Description=Bramble gateway status API forward for the approval console (admin loopback :17899)
After=network-online.target
Wants=network-online.target

[Service]
Environment=HOME=%h
# Read-only path from approval to the gateway statusapi. Both ends stay on
# loopback; statusapi is never exposed on a public interface. Approval reads it
# through BRAMBLED_STATUS_URL=http://127.0.0.1:17899.
ExecStart=/usr/bin/ssh -N -T \
  -o BatchMode=yes -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
  -L 127.0.0.1:17899:127.0.0.1:7899 bramble-gateway
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
