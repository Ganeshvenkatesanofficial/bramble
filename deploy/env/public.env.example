# Names only. Public values for the install host (deploy/scripts/publish-release.sh).
# Keep this file on the operator's machine. It holds NO secret: the generator
# reads only the names below and ignores every other line, so you may also pass
# a node env file with --env. Never put SEPOLIA_RPC_URL here: the generator
# does not read it, because on the admin machine it is the credentialed endpoint.

# --- Public DNS names that point at the relays machine ---
# The installer is served from the console name (spec D8).
BRAMBLE_CONSOLE_HOST=
BRAMBLE_RPC_HOST=

# --- Tailnet (same values the nodes use) ---
BRAMBLE_TAILNET_NAME=
BRAMBLE_TAILNET_REGISTRY=
BRAMBLE_TAILNET_REGISTRY_DEPLOY_BLOCK=
BRAMBLE_RELAY_REGISTRY=
BRAMBLE_RELAY_REGISTRY_DEPLOY_BLOCK=

# --- Network endpoints a new device needs ---
# Logging proxy URL, no credential. Default: https://<BRAMBLE_RPC_HOST>/
# BRAMBLE_PUBLIC_RPC_URL
# Comma-separated host:port lists.
BRAMBLE_STUN_SERVERS=
BRAMBLE_RENDEZVOUS=
# Comma-separated sidecar base URLs of the data relays.
BRAMBLE_DATA_RELAYS=
# Approval service base URL. Default: https://<BRAMBLE_CONSOLE_HOST>
# BRAMBLE_APPROVAL_URL
# Optional comma-separated service names shown in the device UI.
# BRAMBLE_PUBLIC_SERVICES
