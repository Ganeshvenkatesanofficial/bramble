# Relay machine. Replace the two names with the DNS names a human points at this machine.
# Caddy obtains TLS certificates itself. It needs inbound TCP 80 and 443.

# Logging RPC proxy (rpc-proxy on 127.0.0.1:8545). Same block as deploy/rpc-proxy/Caddyfile.
rpc.example.com {
	reverse_proxy 127.0.0.1:8545
}

# Public approval console and installer. The admin machine's loopback :3001 arrives
# here through the reverse SSH tunnel (bramble-console-tunnel.service). Writes need
# the demo token. The installer paths are static files that
# deploy/scripts/publish-release.sh uploads; Caddy only reads them. Everything else
# keeps going to the console.
console.example.com {
	@dist path /install.sh /uninstall.sh /dl/* /.well-known/bramble.json
	handle @dist {
		root * /var/lib/bramble-dist
		header {
			Cache-Control "no-cache"
			X-Content-Type-Options "nosniff"
		}
		@scripts path /install.sh /uninstall.sh
		header @scripts Content-Type "text/x-shellscript; charset=utf-8"
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
