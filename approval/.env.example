# Copy to .env.local on the human-controlled admin machine only. Never commit real values.

# Shared demo token for write requests.
APPROVAL_DEMO_TOKEN=

# Real signer. Leave APPROVAL_GRANTER_LABEL empty to run without it (grant/revoke answer 503).
APPROVAL_GRANTER_LABEL=
# Account that pays for the acl setText transaction (hex). Same variable admincli uses.
SEPOLIA_PRIVATE_KEY=
# Ring-encrypted granter key written by `provision-granter-key`. Absolute path on this machine.
BRAMBLE_GRANTER_KEY_RING_PATH=

# Same tailnet configuration the sidecar and admincli use.
BRAMBLE_TAILNET_NAME=
BRAMBLE_TAILNET_REGISTRY=
# Dedicated Sepolia endpoint; the public pool lags. May carry credentials, so keep it out of logs and git.
SEPOLIA_RPC_URL=
